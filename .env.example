# Telegram API Credentials (Get from https://my.telegram.org)
API_ID=
API_HASH=

# Telegram Bot Token (Get from @BotFather)
BOT_TOKEN=

# Private Telegram Storage Channel ID (e.g. -1001234567890)
CHANNEL_ID=

# Master Password Hash (Auto-generated by Setup Wizard or bcrypted)
MASTER_PASSWORD_HASH=

# AES-256-GCM Zero-Knowledge Encryption Key (Auto-generated by Setup Wizard)
ENCRYPTION_KEY=

# JWT Secret for Session Authentication
JWT_SECRET=

# Server Port (Default: 3000)
PORT=3000

# Telegram Client Reusable Session String (Auto-saved)
SESSION_STRING=
